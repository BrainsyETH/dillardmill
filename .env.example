# Database (Neon). Apply the schema with: npm run db:migrate
DATABASE_URL=postgresql://user:password@host/database

# Square (https://developer.squareup.com/apps)
# SQUARE_ENVIRONMENT / NEXT_PUBLIC_SQUARE_ENVIRONMENT must be "production" for
# live cards; anything else uses the sandbox. Set both to the same value.
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_LOCATION_ID=your_location_id
NEXT_PUBLIC_SQUARE_APPLICATION_ID=your_application_id
NEXT_PUBLIC_SQUARE_LOCATION_ID=your_location_id

# Email (Resend, https://resend.com) — bookings@dillardmill.com must be a verified sender domain
RESEND_API_KEY=your_resend_api_key
ADMIN_EMAIL=pinevalley@dillardmill.com

# Owner admin (/admin)
# Signs admin sessions (32+ random characters). Changing it signs everyone out.
ADMIN_SESSION_SECRET=generate-a-long-random-string
# Google Workspace addresses allowed into /admin, comma-separated.
ADMIN_EMAILS=pinevalley@dillardmill.com
# "Sign in with Google": OAuth web client from Google Cloud, redirect URI
# https://dillardmill.com/api/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional shared-password fallback (12+ characters). Remove once Google sign-in works.
ADMIN_PASSWORD=

# Calendar sync
# Bearer secret for /api/cron/calendar-sync (Vercel cron + GitHub Actions)
CRON_SECRET=generate-a-random-string
# Website calendar feeds for other platforms to import. Off while calendars
# are managed by hand; see docs/BOOKING-ENGINE.md before setting "true".
CALENDAR_EXPORT_ENABLED=false
# Required ?token= on those feeds once enabled
CALENDAR_FEED_TOKEN=generate-a-random-string

# Mapbox (Interactive Property Map)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token

# Site
NEXT_PUBLIC_SITE_URL=https://dillardmill.com

# Cloudflare Turnstile — required for booking and inquiry submissions in production.
# Set a managed widget with the production domain and any preview hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames; defaults to the host in NEXT_PUBLIC_SITE_URL.
# Add the exact Vercel preview host when testing a preview deployment.
TURNSTILE_ALLOWED_HOSTNAMES=dillardmill.com,www.dillardmill.com

# Local development only: send database queries to a local Neon-compatible
# HTTP proxy instead of Neon (ignored in production).
# NEON_FETCH_ENDPOINT=http://localhost:4444/sql

# Wedding/event release switch. Off until the owner is ready to launch.
# Private preview: /admin/events/preview
EVENTS_PUBLISHED=false
# Optional HTTPS booking page for site tours; absent = arrange a visit by email.
EVENT_TOUR_URL=
